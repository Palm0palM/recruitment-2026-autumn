+                _mm512_mul_pd(_mm512_loadu_pd(even + 8), we)));
+            store16f(a.im[p], narrow16(
+                _mm512_mul_pd(_mm512_loadu_pd(odd), wo),
+                _mm512_mul_pd(_mm512_loadu_pd(odd + 8), wo)));
+        }
+    }
+};
